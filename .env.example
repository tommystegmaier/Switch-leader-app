# ---------------------------------------------------------------------------
# Team Hub Platform — environment variables
#
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# NEVER commit your real `.env`. Only this `.env.example` is committed.
#
# All client-exposed vars MUST be prefixed with VITE_ so Vite inlines them.
# The Supabase anon key is safe to expose to the browser; Row-Level Security
# (RLS) — not key secrecy — is what enforces tenant isolation and read-only
# viewers. NEVER put the service_role key in any VITE_ variable.
# ---------------------------------------------------------------------------

# Your Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=

# Your Supabase "anon" public API key (Project Settings → API).
VITE_SUPABASE_ANON_KEY=

# Web Push public (VAPID) key — safe to expose. Generate a keypair and set the
# PUBLIC key here; the PRIVATE key is a server-only secret for the send function
# (see PUSH-SETUP.md). Leave blank to disable notifications.
VITE_VAPID_PUBLIC_KEY=

# Optional: make this deployment open ONE workspace directly at the root URL
# (so a custom domain "is" that app). Set to the workspace slug, e.g. "switch".
# Leave blank for the normal multi-tenant home. The creator dashboard is always
# reachable at /workspaces.
VITE_DEFAULT_ORG_SLUG=
